---
layout: layouts/base.njk
title: {{ site.title }}
---
<input type="checkbox" id="navToggle" class="nav-toggle-input">

<nav id="navbar">
    <div class="logo">{{ site.brand }}</div>
    <ul class="nav-links" id="navLinks">
        {% for item in site.nav %}
        <li><a href="{{ item.href }}">{{ item.label }}</a></li>
        {% endfor %}
    </ul>
    <label for="navToggle" class="hamburger" aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
    </label>
</nav>

<input type="checkbox" id="bannerClose" class="banner-close-input">
<div class="mobile-only-banner" id="mobileBanner">
    <span class="mobile-banner-icon">{{ site.mobileBanner.icon }}</span>
    <div>
        <strong>{{ site.mobileBanner.title }}</strong>
        <p>{{ site.mobileBanner.description }} <code>{{ site.mobileBanner.code }}</code></p>
    </div>
    <label for="bannerClose" class="mobile-banner-close">{{ site.mobileBanner.closeLabel }}</label>
</div>

<header id="hero" class="hero-section">
    <div class="hero-content">
        <h1>{{ site.hero.title }}</h1>
        <p>{{ site.hero.description }}</p>
        <a href="{{ site.hero.primaryCtaHref }}" class="cta-button">{{ site.hero.primaryCtaText }}</a>
        <a href="{{ site.hero.secondaryCtaHref }}" class="cta-button cta-secondary mobile-only-cta">{{ site.hero.secondaryCtaText }}</a>
    </div>
</header>
<section id="collection" class="section-padding">
    <h2 class="section-title">{{ site.collection.title }}</h2>
    <div class="product-grid">
        {% for product in site.collection.products %}
        <div class="product-card">
            <img src="{{ product.image }}" alt="{{ product.imageAlt }}" class="product-img">
            <h3>{{ product.title }}</h3>
            <p>{{ product.price }}</p>
            <button>{{ product.buttonText }}</button>
        </div>
        {% endfor %}
    </div>
</section>

<section id="quality" class="section-padding quality-bg">
    <h2 class="section-title">{{ site.quality.title }}</h2>
    <p class="quality-subtitle">{{ site.quality.subtitle }}</p>
    <div class="quality-grid">
        {% for item in site.quality.items %}
        <div class="quality-item">
            <h3>{{ item.title }}</h3>
            <p>{{ item.description }}</p>
        </div>
        {% endfor %}
    </div>
</section>

<section id="newsletter" class="py-16 px-4 text-center" style="background-color: var(--primary);">
    <div class="max-w-2xl mx-auto">
        <h2 class="text-3xl font-bold mb-3 text-white">{{ site.newsletter.title }}</h2>
        <p class="text-base mb-8 text-white max-w-lg mx-auto">
            {{ site.newsletter.description }}
        </p>
        <form class="flex flex-col sm:flex-row justify-center gap-3 max-w-md mx-auto">
            <input
                type="email"
                placeholder="{{ site.newsletter.placeholder }}"
                required
                class="flex-1 px-4 py-3 rounded text-gray-900 text-base outline-none"
            >
            <button
                type="submit"
                class="newsletter-submit-btn px-6 py-3 font-bold rounded text-white transition-colors duration-200 whitespace-nowrap"
            >
                {{ site.newsletter.buttonText }}
            </button>
        </form>
    </div>
</section>

<section id="custom-order" class="section-padding">
    <h2 class="section-title">{{ site.customOrder.title }}</h2>
    <p style="text-align: center; max-width: 600px; margin: 0 auto 2rem;">{{ site.customOrder.description }}</p>
    <form class="custom-order-form">
        <div class="form-group">
            <label for="name">{{ site.customOrder.nameLabel }}</label>
            <input type="text" id="name" placeholder="{{ site.customOrder.namePlaceholder }}" required>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="email">{{ site.customOrder.emailLabel }}</label>
                <input type="email" id="email" placeholder="{{ site.customOrder.emailPlaceholder }}" required>
            </div>
            <div class="form-group">
                <label for="phone">{{ site.customOrder.phoneLabel }}</label>
                <input type="tel" id="phone" placeholder="{{ site.customOrder.phonePlaceholder }}">
            </div>
        </div>
        <div class="form-group">
            <label for="details">{{ site.customOrder.detailsLabel }}</label>
            <textarea id="details" rows="5" placeholder="{{ site.customOrder.detailsPlaceholder }}"></textarea>
        </div>
        <button type="submit" class="submit-btn">{{ site.customOrder.submitText }}</button>
    </form>
</section>

<section id="about" class="section-padding about-bg">
    <div class="about-content">
        <h2 class="section-title">{{ site.about.title }}</h2>
        {% for paragraph in site.about.paragraphs %}
        <p>{{ paragraph }}</p>
        {% endfor %}
    </div>
</section>

<footer>
    <p>{{ site.footer.text }}</p>
</footer>

<div id="mascot" class="mascot-container" role="img" aria-label="{{ site.mascot.ariaLabel }}">
    <div class="mascot-bubble">
        <p>{{ site.mascot.greeting }} <strong>{{ site.mascot.name }}</strong>!</p>
        <p>{{ site.mascot.description }}</p>
        <a href="{{ site.mascot.ctaHref }}" class="mascot-cta-link">{{ site.mascot.ctaText }}</a>
    </div>
    <svg class="mascot-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <rect x="20" y="52" width="60" height="28" rx="8" fill="#1565c0"/>
        <rect x="23" y="28" width="54" height="30" rx="8" fill="#1976d2"/>
        <rect x="10" y="46" width="15" height="26" rx="6" fill="#1565c0"/>
        <rect x="75" y="46" width="15" height="26" rx="6" fill="#1565c0"/>
        <rect x="25" y="78" width="9" height="13" rx="3" fill="#0d47a1"/>
        <rect x="66" y="78" width="9" height="13" rx="3" fill="#0d47a1"/>
        <rect x="28" y="56" width="44" height="16" rx="5" fill="#42a5f5" opacity="0.45"/>
        <ellipse cx="50" cy="41" rx="19" ry="15" fill="#bbdefb"/>
        <circle cx="43" cy="39" r="3.5" fill="white"/>
        <circle cx="57" cy="39" r="3.5" fill="white"/>
        <circle cx="43.8" cy="39.5" r="2" fill="#0d47a1"/>
        <circle cx="57.8" cy="39.5" r="2" fill="#0d47a1"/>
        <circle cx="44.5" cy="38.7" r="0.7" fill="white"/>
        <circle cx="58.5" cy="38.7" r="0.7" fill="white"/>
        <path d="M44 45 Q50 51 56 45" stroke="#0d47a1" stroke-width="2" stroke-linecap="round" fill="none"/>
        <circle cx="39" cy="44" r="3" fill="#f48fb1" opacity="0.5"/>
        <circle cx="61" cy="44" r="3" fill="#f48fb1" opacity="0.5"/>
    </svg>
    <div class="mascot-name">{{ site.mascot.name }}</div>
</div>
